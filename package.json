{
  "name": "sessionweave",
  "version": "0.1.0-beta.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Model-agnostic persistent sessions and validated context compaction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-decoy/session_weave.git"
  },
  "homepage": "https://github.com/Ethan-decoy/session_weave#readme",
  "bugs": {
    "url": "https://github.com/Ethan-decoy/session_weave/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./file-store": {
      "types": "./dist/file-store.d.ts",
      "import": "./dist/file-store.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./native": {
      "types": "./dist/native-adapters.d.ts",
      "import": "./dist/native-adapters.js"
    },
    "./om": {
      "types": "./dist/om.d.ts",
      "import": "./dist/om.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "docs/api.md",
    "docs/native-api.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "example": "npm run build && node examples/quickstart.mjs",
    "example:native": "npm run build && node examples/native-roundtrip.mjs",
    "example:om": "npm run build && node examples/om-roundtrip.mjs",
    "example:raw": "npm run build && node examples/raw-pages.mjs",
    "example:ticket": "npm run build && node examples/memory-ticket.mjs"
  },
  "devDependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/memory": "1.39.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/memory": "1.39.0"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    },
    "@mastra/memory": {
      "optional": true
    }
  }
}
